{
  // openapi-generator が再生成する tsconfig.json は composite を持たない。
  // それを上書き編集すると再生成で消えるため、TS Project References 用の
  // 設定はこのサイドカー (.openapi-generator/FILES 非対象) に隔離する。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
