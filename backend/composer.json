{
  "minimum-stability": "RC",
  "repositories": [],
  "description": "TRViS Timetable Server backend (code-first: PHP implementation is the API source of truth)",
  "keywords": [
    "trvis"
  ],
  "homepage": "https://trvis.t0r.dev",
  "license": "MIT",
  "authors": [
    {
      "name": "Tetsu Otter",
      "homepage": "https://t0r.dev"
    }
  ],
  "require": {
    "php": ">=8.4.1",
    "google/auth": "1.50.1",
    "google/cloud-core": "1.72.1",
    "guzzlehttp/guzzle": "7.10.4",
    "guzzlehttp/psr7": "2.10.2",
    "kreait/firebase-php": "^8.2",
    "monolog/monolog": "^3.10",
    "neomerx/cors-psr7": "^3.0",
    "php-di/slim-bridge": "^3.4",
    "ramsey/uuid": "^4.9",
    "slim/psr7": "^1.8",
    "symfony/cache": "8.0.12",
    "symfony/console": "8.0.11",
    "symfony/lock": "8.0.9",
    "symfony/options-resolver": "8.0.8",
    "symfony/polyfill-intl-grapheme": "1.37.0",
    "symfony/polyfill-intl-normalizer": "1.37.0",
    "symfony/polyfill-mbstring": "1.37.0",
    "symfony/rate-limiter": "8.0.13",
    "symfony/string": "8.0.13",
    "symfony/var-exporter": "8.0.9",
    "symfony/yaml": "8.0.12"
  },
  "require-dev": {
    "overtrue/phplint": "^9.7",
    "phpunit/phpunit": "13.1.11",
    "sebastian/environment": "9.3.1",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/event-dispatcher": "8.0.9",
    "symfony/finder": "8.0.8",
    "symfony/process": "8.0.13",
    "symfony/type-info": "8.0.9",
    "zircote/swagger-php": "^6.1"
  },
  "autoload": {
    "psr-4": { "dev_t0r\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "dev_t0r\\trvis_backend\\tests\\": "tests/" },
    "classmap": [ "tests/Integration/" ]
  },
  "scripts": {
    "test": [
      "phpunit"
    ],
    "test-apis": "phpunit --testsuite Apis",
    "test-unit": "phpunit --testsuite Unit",
    "phpcs": "phpcs",
    "phplint": "phplint ./ --exclude=vendor",
    "openapi": "openapi src/ --bootstrap vendor/autoload.php -o openapi.json --format json",
    "cleanup-orphans": "php bin/cleanup-orphans.php"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    }
  }
}
