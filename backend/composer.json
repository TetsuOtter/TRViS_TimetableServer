{
  "minimum-stability": "RC",
  "repositories": [],
  "description": "",
  "keywords": [
    "trvis"
  ],
  "homepage": "https://trvis.t0r.dev",
  "license": "MIT",
  "authors": [
    {
      "name": "Tetsu Otter",
      "homepage": "https://t0r.dev"
    }
  ],
  "require": {
    "php": "^8.2",
    "google/cloud-core": "1.72.0",
    "kreait/firebase-php": "^7.24",
    "monolog/monolog": "^3.10",
    "neomerx/cors-psr7": "^3.0",
    "php-di/slim-bridge": "^3.4",
    "ramsey/uuid": "^4.9",
    "slim/psr7": "^1.8",
    "symfony/cache": "^7.4",
    "symfony/console": "7.4.9",
    "symfony/string": "7.4.8",
    "symfony/yaml": "7.4.10",
    "ybelenko/openapi-data-mocker": "^1.1",
    "ybelenko/openapi-data-mocker-server-middleware": "^1.2"
  },
  "require-dev": {
    "overtrue/phplint": "^9.7",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": { "dev_t0r\\": [
      "lib/",
      "src/"
    ]}
  },
  "autoload-dev": {
    "psr-4": { "dev_t0r\\": "tests/" }
  },
  "scripts": {
    "test": [
      "phpunit"
    ],
    "test-apis": "phpunit --testsuite Apis",
    "test-models": "phpunit --testsuite Models",
    "phpcs": "phpcs",
    "phplint": "phplint ./ --exclude=vendor"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    }
  }
}
