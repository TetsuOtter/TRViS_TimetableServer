{
  "minimum-stability": "RC",
  "repositories": [],
  "description": "TRViS Timetable Server backend (code-first: PHP implementation is the API source of truth)",
  "keywords": [
    "trvis"
  ],
  "homepage": "https://trvis.t0r.dev",
  "license": "MIT",
  "authors": [
    {
      "name": "Tetsu Otter",
      "homepage": "https://t0r.dev"
    }
  ],
  "require": {
    "php": "^8.2",
    "google/cloud-core": "1.72.0",
    "kreait/firebase-php": "^7.24",
    "monolog/monolog": "^3.10",
    "neomerx/cors-psr7": "^3.0",
    "php-di/slim-bridge": "^3.4",
    "ramsey/uuid": "^4.9",
    "slim/psr7": "^1.8",
    "symfony/cache": "^7.4",
    "symfony/console": "7.4.9",
    "symfony/lock": "^7.4",
    "symfony/rate-limiter": "^7.4",
    "symfony/string": "7.4.8",
    "symfony/yaml": "7.4.10"
  },
  "require-dev": {
    "overtrue/phplint": "^9.7",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^4.0",
    "zircote/swagger-php": "^4.10"
  },
  "autoload": {
    "psr-4": { "dev_t0r\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "dev_t0r\\trvis_backend\\tests\\": "tests/" },
    "classmap": [ "tests/Integration/" ]
  },
  "scripts": {
    "test": [
      "phpunit"
    ],
    "test-apis": "phpunit --testsuite Apis",
    "test-unit": "phpunit --testsuite Unit",
    "phpcs": "phpcs",
    "phplint": "phplint ./ --exclude=vendor",
    "openapi": "openapi src/ --bootstrap vendor/autoload.php -o openapi.json --format json",
    "cleanup-orphans": "php bin/cleanup-orphans.php"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    }
  }
}
