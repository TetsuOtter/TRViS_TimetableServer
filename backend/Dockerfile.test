# テストランナー専用イメージ。本番の Dockerfile (php:8.4-apache, --no-dev) は
# PHPUnit を含まないため、結合テストを docker compose で回すための別イメージ。
# composer.json は php>=8.4.1 / phpunit 13 を要求する (PHPUnit 13 は PHP>=8.4.1
# 必須)。本番 (8.4-apache) / CI (setup-php 8.4) と同じ 8.4 系に揃える。
# 拡張 (pdo_mysql, intl, bcmath, mbstring) はバージョン非依存でそのまま載る。
FROM php:8.4-cli

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		libicu-dev libonig-dev git unzip default-mysql-client \
	&& docker-php-ext-install pdo_mysql intl bcmath mbstring \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# エントリポイントは /usr/local/bin に置く。コード (/app) は compose の bind mount
# で供給されるため、ここに置かないとマウントでシャドウされて消える。
COPY docker-test-entrypoint.sh /usr/local/bin/docker-test-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-test-entrypoint.sh

WORKDIR /app
ENTRYPOINT ["/usr/local/bin/docker-test-entrypoint.sh"]
