# ref: https://github.com/github/gitignore/blob/master/Composer.gitignore

composer.phar
/vendor/*
!/vendor/.gitkeep

# Commit your application's lock file https://getcomposer.org/doc/01-basic-usage.md#commit-your-composer-lock-file-to-version-control
# You may choose to ignore a library lock file http://getcomposer.org/doc/02-libraries.md#lock-file
# composer.lock

# phplint tool creates cache file which is not necessary in a codebase
/.phplint-cache

# Do not commit local PHPUnit config
/phpunit.xml
/.phpunit.result.cache
# PHPUnit 10+ cache directory (cacheDirectory in phpunit.xml.dist)
/.phpunit.cache/

# Do not commit local PHP_CodeSniffer config
/phpcs.xml

# Application config may contain sensitive data
/config/**/*.*
!/config/.htaccess
!/config/dev/default.inc.php
!/config/prod/default.inc.php
!/config/prod/config.docker.inc.php
# E2E config is intentionally tracked: it holds the dev/emulator-only workarounds
# (EMULATE_PREPARES + rate-limit relax) so CI/local E2E are reproducible from a
# clean checkout. Selected only by docker-compose.e2e.yaml; prod is unaffected.
!/config/prod/config.e2e.inc.php

# Logs folder
/logs/**/*.*
!/logs/.htaccess

.phplint.cache/
